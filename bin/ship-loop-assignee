#!/usr/bin/env bash
# Set or show who /ship-loop-ios and /ship-loop-web assign Linear tickets to.
#   ship-loop-assignee "Name"                    every repo  (~/.config/ship-loop/config.json)
#   ship-loop-assignee --project [DIR] "Name"    one repo    (DIR/.claude/ship-loop.local.json, gitignored)
#   ship-loop-assignee --show [DIR]              print what a run in DIR would use
set -euo pipefail

global="${XDG_CONFIG_HOME:-$HOME/.config}/ship-loop/config.json"

usage() { sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

read_assignee() { # file -> value or empty
  [ -f "$1" ] || return 0
  python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("linear_assignee",""))' "$1"
}

write_assignee() { # file name
  mkdir -p "$(dirname "$1")"
  python3 -I - "$1" "$2" <<'PY'
import json, os, sys
path, name = sys.argv[1], sys.argv[2]
data = json.load(open(path)) if os.path.exists(path) else {}
data["linear_assignee"] = name
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
  echo "linear_assignee = \"$2\" -> $1"
}

case "${1:-}" in
  ""|-h|--help) usage ;;
  --show)
    dir="${2:-.}"
    for f in "$dir/.claude/ship-loop.local.json" "$global"; do
      v="$(read_assignee "$f")"
      if [ -n "$v" ]; then echo "$v  (from $f)"; exit 0; fi
    done
    echo "not set: the next run will ask and save it to $global"; exit 1 ;;
  --project)
    shift
    if [ $# -eq 2 ]; then dir="$1"; name="$2"; elif [ $# -eq 1 ]; then dir="."; name="$1"; else usage 1; fi
    [ -n "$name" ] || usage 1
    write_assignee "$dir/.claude/ship-loop.local.json" "$name"
    gi="$dir/.gitignore"
    if ! grep -qxF ".claude/ship-loop.local.json" "$gi" 2>/dev/null; then
      [ -s "$gi" ] && [ -n "$(tail -c1 "$gi")" ] && echo >> "$gi"
      echo ".claude/ship-loop.local.json" >> "$gi"
      echo "added .claude/ship-loop.local.json to $gi"
    fi ;;
  -*) usage 1 ;;
  *)
    [ $# -eq 1 ] || usage 1
    write_assignee "$global" "$1" ;;
esac
